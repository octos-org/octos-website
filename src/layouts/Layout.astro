---
import Seo from 'components/Seo.astro';
import Header from 'components/layout/Header.astro';
import Footer from 'components/layout/Footer.astro';
import 'styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: string;
  navLinks?: { text: string; href: string }[];
  externalLinks?: { text: string; href: string }[];
  langAlt?: { text: string; href: string };
  footerLinks?: { text: string; href: string }[];
  footerExternal?: { text: string; href: string }[];
  footerBrand?: string;
}

const {
  title,
  description,
  ogImage,
  lang = 'en',
  navLinks,
  externalLinks,
  langAlt,
  footerLinks,
  footerExternal,
  footerBrand,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') {
          document.documentElement.setAttribute('data-theme', theme);
        }
      })();
    </script>
    <Seo title={title} description={description} ogImage={ogImage} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header navLinks={navLinks} externalLinks={externalLinks} langAlt={langAlt} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer links={footerLinks} external={footerExternal} brand={footerBrand} langAlt={langAlt} />

    <!-- No scroll-reveal JS needed — content visible by default -->
  </body>
</html>
