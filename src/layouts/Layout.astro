---
import Seo from 'components/Seo.astro';
import Header from 'components/layout/Header.astro';
import Footer from 'components/layout/Footer.astro';
import 'styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  lang?: string;
  navLinks?: { text: string; href: string }[];
  externalLinks?: { text: string; href: string }[];
  langAlt?: { text: string; href: string };
  footerLinks?: { text: string; href: string }[];
  footerExternal?: { text: string; href: string }[];
  footerBrand?: string;
  footerOwnership?: string;
  footerNavHeading?: string;
  footerResourcesHeading?: string;
  footerLicense?: string;
  footerLangHrefEn?: string;
  footerLangHrefZh?: string;
}

const {
  title,
  description,
  ogImage,
  lang = 'en',
  navLinks,
  externalLinks,
  langAlt,
  footerLinks,
  footerExternal,
  footerBrand,
  footerOwnership,
  footerNavHeading,
  footerResourcesHeading,
  footerLicense,
  footerLangHrefEn,
  footerLangHrefZh,
} = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <!-- Prevent flash of wrong theme -->
    <script is:inline>
      (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') {
          document.documentElement.setAttribute('data-theme', theme);
        }
      })();
    </script>
    <Seo title={title} description={description} ogImage={ogImage} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header navLinks={navLinks} externalLinks={externalLinks} langAlt={langAlt} homeHref={lang.startsWith('zh') ? '/zh/' : '/'} menuLabel={lang.startsWith('zh') ? '打开导航菜单' : 'Toggle menu'} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer links={footerLinks} external={footerExternal} brand={footerBrand} ownership={footerOwnership} langAlt={langAlt} navHeading={footerNavHeading} resourcesHeading={footerResourcesHeading} license={footerLicense} langHrefEn={footerLangHrefEn} langHrefZh={footerLangHrefZh} />

    <!-- No scroll-reveal JS needed — content visible by default -->
  </body>
</html>
