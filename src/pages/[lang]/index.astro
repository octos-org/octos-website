---
import Layout from 'layouts/Layout.astro';
import Hero from 'components/sections/Hero.astro';
import Stats from 'components/sections/Stats.astro';
import Features from 'components/sections/Features.astro';
import Architecture from 'components/sections/Architecture.astro';
import DeepResearch from 'components/sections/DeepResearch.astro';
import ToolSystem from 'components/sections/ToolSystem.astro';
import Memory from 'components/sections/Memory.astro';
import ContentGen from 'components/sections/ContentGen.astro';
import Security from 'components/sections/Security.astro';
import Performance from 'components/sections/Performance.astro';
import Channels from 'components/sections/Channels.astro';
import Providers from 'components/sections/Providers.astro';
import Comparison from 'components/sections/Comparison.astro';
import UseCases from 'components/sections/UseCases.astro';
import QuickStart from 'components/sections/QuickStart.astro';
import FAQ from 'components/sections/FAQ.astro';
import CTA from 'components/sections/CTA.astro';
import { getTranslations, getLangAlt, type Lang } from 'i18n/index';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh-cn' } },
  ];
}

const lang = Astro.params.lang as Lang;
const t = getTranslations(lang);
const langAlt = getLangAlt(lang);
---

<Layout
  title={t.site.title}
  description={t.site.description}
  lang="zh-CN"
  navLinks={t.header.navLinks}
  externalLinks={t.header.externalLinks}
  langAlt={langAlt}
  footerLinks={t.footer.links}
  footerExternal={t.footer.external}
  footerBrand={t.footer.brandDescription}
>
  <Hero t={t.hero} />
  <Stats t={t.stats} />
  <Features t={t.features} />
  <Architecture t={t.architecture} />
  <DeepResearch t={t.deepResearch} />
  <ToolSystem t={t.toolSystem} />
  <Memory t={t.memory} />
  <ContentGen t={t.contentGen} />
  <Security t={t.security} />
  <Performance t={t.performance} />
  <Channels t={t.channels} />
  <Providers t={t.providers} />
  <Comparison t={t.comparison} />
  <UseCases t={t.useCases} />
  <QuickStart t={t.quickStart} />
  <FAQ t={t.faq} />
  <CTA t={t.cta} />
</Layout>
