---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    tiers: { stat: string; label: string; description: string }[];
    toolGroups: { label: string; tools: string[] }[];
  };
}

const { t } = Astro.props;
---

<Section background="secondary" padY="lg">
  <Container>
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:gap-16">
      <div data-animate>
        <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
        <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
          {t.heading}
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-neutral-2">
          {t.description}
        </p>

        <div class="mt-8 space-y-4">
          {t.tiers.map((tier) => (
            <div class="flex items-center gap-4">
              <span class="w-20 shrink-0 text-right font-mono text-[24px] text-text-bright">{tier.stat}</span>
              <div>
                <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-accent">{tier.label}</p>
                <p class="text-[14px] text-neutral-2">{tier.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div data-animate>
        <div class="space-y-6">
          {t.toolGroups.map((group) => (
            <div>
              <p class="mb-3 font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{group.label}</p>
              <div class="flex flex-wrap gap-2">
                {group.tools.map((tool) => (
                  <span class="rounded-sm border border-surface-3 bg-surface-1 px-2 py-1 font-mono text-[11px] text-neutral-2">{tool}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>
