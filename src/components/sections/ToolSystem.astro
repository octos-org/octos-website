---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    tiers: { stat: string; label: string; description: string }[];
    toolGroups: { label: string; tools: string[] }[];
  };
}

const { t } = Astro.props;
---

<Section background="secondary" padY="lg">
  <Container>
    <!-- Top row: heading + description + stats -->
    <div data-animate class="mb-12">
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
        {t.heading}
      </h2>
      <p class="mt-4 max-w-2xl text-[16px] leading-relaxed text-neutral-2">
        {t.description}
      </p>

      <div class="mt-8 grid grid-cols-1 gap-8 md:grid-cols-3">
        {t.tiers.map((tier) => (
          <div class="flex items-center gap-4">
            <span class:list={["shrink-0 font-mono text-text-bright", tier.stat === '∞' ? 'text-[52px]' : 'text-[36px]']}>{tier.stat}</span>
            <div>
              <p class="font-mono text-[16px] uppercase tracking-[0.08em] text-accent">{tier.label}</p>
              <p class="text-[14px] text-neutral-2">{tier.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom row: three boxes -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3" data-animate>
      {t.toolGroups.map((group) => (
        <div class="glass-panel">
          <p class="mb-3 font-mono text-[16px] uppercase tracking-[0.08em] text-text-bright">{group.label}</p>
          <div class="flex flex-wrap gap-2">
            {group.tools.map((tool) => (
              <span class="rounded-sm border border-surface-3 bg-surface-1 px-2 py-1 font-mono text-[13px] text-yellow-400">{tool}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
