---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="flex flex-col items-center gap-2 text-center md:row-span-2 md:grid md:grid-rows-subgrid">
  <span class="font-mono text-[30px] leading-none tracking-[-0.02em] text-text-bright md:self-end md:text-[38px]" set:html={value} />
  <span class="text-balance font-mono text-[13px] uppercase leading-relaxed tracking-[0.06em] text-neutral-2 md:self-start md:text-[14px]" set:html={label} />
</div>
