---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="flex h-full flex-col items-center justify-between gap-2 text-center">
  <span class="font-mono text-[32px] leading-none tracking-[-0.02em] text-text-bright md:text-[40px]">
    {value}
  </span>
  <span class="font-mono text-[14px] uppercase tracking-[0.08em] text-neutral-2 md:text-[16px]">
    {label}
  </span>
</div>
