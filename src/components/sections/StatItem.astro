---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="flex flex-col items-center gap-1 text-center">
  <span class="font-mono text-[32px] leading-tight tracking-[-0.02em] text-text-bright md:text-[40px]" set:html={value} />
  <span class="font-mono text-[16px] uppercase tracking-[0.08em] text-neutral-2 md:text-[18px]" set:html={label} />
</div>
