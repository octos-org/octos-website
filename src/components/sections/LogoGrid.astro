---

<div class:list={['grid gap-4', gridClass]}>
  {items.map((item) => {
    const icon = icons[item.name];
    return (
      <div class="group flex flex-col items-center gap-3 rounded-sm border border-surface-3 bg-surface-1 px-3 py-5 transition-colors duration-300 hover:border-neutral-1">
        {icon ? (
          <svg
            viewBox={icon.viewBox || '0 0 24 24'}
            fill="currentColor"
            class="size-8 text-neutral-2 transition-colors duration-300 group-hover:text-accent"
            set:html={icon.paths}
          />
        ) : (
          <span class="flex size-8 items-center justify-center font-mono text-[10px] text-neutral-2 transition-colors duration-300 group-hover:text-accent">
            {item.name.slice(0, 2)}
          </span>
        )}
        <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-neutral-2 transition-colors duration-300 group-hover:text-accent">
          {item.name}
        </span>
      </div>
    );
  })}
</div>
