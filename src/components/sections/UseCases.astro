---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';

const cases = [
  {
    label: '01',
    title: 'Enterprise SaaS Platforms',
    description: 'Embed AI agents into your product via REST API. Multi-tenant isolation means each customer gets their own profile with separate memory, sessions, and data — on a single binary.',
    highlights: ['91 REST endpoints', 'Per-profile isolation', 'Admin dashboard'],
  },
  {
    label: '02',
    title: 'Multi-Channel Customer Support',
    description: 'Deploy one agent across Telegram, Discord, Slack, WhatsApp, Email, and 9 more channels simultaneously. Session control lets users switch contexts without losing history.',
    highlights: ['14 channels', 'Session switching', '5 queue modes'],
  },
  {
    label: '03',
    title: 'Research & Analysis Pipelines',
    description: 'Orchestrate multi-LLM pipelines as DOT graphs. Use cheap models for planning, expensive ones for synthesis. 8 concurrent search workers with 6-provider failover.',
    highlights: ['DOT pipeline engine', '8 search workers', '6-provider failover'],
  },
  {
    label: '04',
    title: 'Content Generation at Scale',
    description: 'Native PPTX, DOCX, and XLSX generation from pure Rust — no external dependencies. AI art pipeline with 17 styles for cards, comics, infographics, and slides.',
    highlights: ['Native Office suite', '17 art styles', 'Zero deps'],
  },
  {
    label: '05',
    title: 'Team & Family AI',
    description: 'Multi-tenant by design — a small team can run 200+ specialized AI agents on a single machine. Sub-accounts with parent/child profiles for family plans.',
    highlights: ['200+ profiles', 'Sub-accounts', '20MB per gateway'],
  },
  {
    label: '06',
    title: 'High-Volume Inference',
    description: 'True parallelism via Rust/tokio with zero garbage collection. Deterministic performance under load. 10x tenant density compared to Node.js alternatives.',
    highlights: ['10x density', '<100ms startup', 'Zero GC pauses'],
  },
];
---

<Section id="usecases" padY="lg">
  <Container>
    <div class="mb-12 lg:mb-16" data-animate>
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">Use Cases</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
        Built for real workloads
      </h2>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden border border-surface-3 md:grid-cols-2 lg:grid-cols-3" data-animate-stagger>
      {cases.map((c) => (
        <div class="group bg-surface-1 p-6 transition-colors duration-300 hover:bg-surface-2 lg:p-8">
          <span class="font-mono text-[11px] text-neutral-1">{c.label}</span>
          <h3 class="mt-3 text-[18px] tracking-[-0.01em] lg:text-[20px]">{c.title}</h3>
          <p class="mt-3 text-[14px] leading-relaxed text-neutral-2">{c.description}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {c.highlights.map((h) => (
              <span class="rounded-sm bg-surface-3 px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em] text-neutral-2 transition-colors duration-300 group-hover:text-accent">
                {h}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </Container>
</Section>
