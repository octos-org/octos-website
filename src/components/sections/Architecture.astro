---
import SvgSection from 'components/ui/SvgSection.astro';
import ArchitectureFlow from 'components/ArchitectureFlow.jsx';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    modules: { color: string; name: string; description: string }[];
  };
}

const { t } = Astro.props;
---

<SvgSection id="architecture" bgSrc="/images/bg-coral-panel.png">
  <!-- Text: heading + description on left, modules on right -->
  <div class="glass-panel">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-12">
      <div class="lg:flex-1">
        <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
        <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]" set:html={t.heading} />
        <p class="mt-4 text-[20px] leading-relaxed text-text-bright">
          {t.description}
        </p>
      </div>
    </div>
  </div>

  <!-- Module cards -->
  <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {t.modules.map((mod) => (
      <div class="glass-panel !py-4 !px-5">
        <div class="flex items-center gap-2.5 mb-2">
          <span class={`block size-2.5 shrink-0 rounded-full ${mod.color}`} />
          <span class="font-mono text-[15px] font-medium text-text-bright">{mod.name}</span>
        </div>
        <p class="text-[14px] leading-relaxed text-highlight">{mod.description}</p>
      </div>
    ))}
  </div>

  <!-- React Flow diagram — full width below -->
  <div class="glass-panel mt-6 min-h-[500px]">
    <ArchitectureFlow client:only="react" />
  </div>
</SvgSection>
