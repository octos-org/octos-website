---
import SvgSection from 'components/ui/SvgSection.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    features: { label: string; description: string }[];
    lifecycle: { name: string; description: string }[];
    note: string;
  };
}

const { t } = Astro.props;
---

<SvgSection id="context" bgSrc="/images/bg-coral-panel.webp" creatures="coral">
  <div class="glass-panel">
    <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
    <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]" set:html={t.heading} />
    <p class="mt-4 text-[16px] leading-relaxed text-neutral-2">{t.description}</p>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
    {t.features.map((feature) => (
      <div class="glass-panel">
        <p class="font-mono text-[16px] uppercase tracking-[0.08em] text-accent">{feature.label}</p>
        <p class="mt-2 text-[14px] leading-relaxed text-neutral-2">{feature.description}</p>
      </div>
    ))}
  </div>

  <div class="glass-panel mt-4">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
      {t.lifecycle.map((item) => (
        <div>
          <p class="font-mono text-[12px] text-accent">{item.name}</p>
          <p class="mt-2 text-[14px] leading-relaxed text-neutral-2">{item.description}</p>
        </div>
      ))}
    </div>
    <p class="mt-6 text-[14px] leading-relaxed text-highlight">{t.note}</p>
  </div>
</SvgSection>
