---
import SvgSection from 'components/ui/SvgSection.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    layers: { colorLabel: string; color: string; title: string; description: string }[];
  };
}

const { t } = Astro.props;
---

<SvgSection bgSrc="/images/bg-floor-panel.png">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-7 lg:gap-8">
    <div class="glass-panel lg:col-span-3">
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
        {t.heading}
      </h2>
      <p class="mt-4 text-[16px] leading-relaxed text-highlight">
        {t.description}
      </p>
    </div>

    <div class="flex flex-col gap-4 lg:col-span-4">
      {t.layers.map((layer) => (
        <div class={`glass-panel border-l-2 !border-l-${layer.color}`}>
          <p class={`font-mono text-[12px] uppercase tracking-[0.08em] text-${layer.color}`}>{layer.colorLabel}</p>
          <h3 class="mt-2 text-[18px] tracking-[-0.01em]">{layer.title}</h3>
          <p class="mt-1 text-[14px] leading-relaxed text-highlight">
            {layer.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</SvgSection>
