---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';
import CodeBlock from 'components/ui/CodeBlock.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    targets: { name: string; artifact: string; description: string }[];
    code: string;
    codeTitle: string;
    platformsLabel: string;
    platforms: string[];
  };
}

const { t } = Astro.props;
---

<Section id="embedding" background="secondary" padY="lg">
  <Container>
    <div class="mb-12 lg:mb-16" data-animate>
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] text-text-bright md:text-[36px] lg:text-[48px]" set:html={t.heading} />
      <p class="mt-4 max-w-2xl text-[16px] leading-relaxed text-neutral-2">{t.description}</p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden border border-surface-3 md:grid-cols-2 lg:grid-cols-5" data-animate-stagger>
      {t.targets.map((target) => (
        <div class="bg-surface-1 p-5 outline outline-1 outline-surface-3">
          <p class="text-[16px] text-text-bright">{target.name}</p>
          <p class="mt-2 font-mono text-[11px] text-accent">{target.artifact}</p>
          <p class="mt-3 text-[14px] leading-relaxed text-neutral-2">{target.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-2" data-animate>
      <CodeBlock code={t.code} title={t.codeTitle} />
      <div class="flex flex-col justify-center">
        <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.platformsLabel}</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {t.platforms.map((platform) => (
            <li class="border border-surface-3 px-3 py-1.5 font-mono text-[12px] text-neutral-2">{platform}</li>
          ))}
        </ul>
      </div>
    </div>
  </Container>
</Section>
