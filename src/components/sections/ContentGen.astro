---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    formats: { name: string; description: string }[];
    art: {
      label: string;
      heading: string;
      description: string;
      styles: string[];
    };
  };
}

const { t } = Astro.props;
---

<Section padY="lg">
  <Container>
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- 文档、幻灯片、表格 -->
      <div class="glass-panel flex flex-col">
        <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
        <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
          {t.heading}
        </h2>
        <p class="mt-4 text-[16px] leading-relaxed text-neutral-2">
          {t.description}
        </p>

        <div class="mt-8 flex flex-col gap-4">
          {t.formats.map((f) => (
            <div class="flex items-start gap-4 border border-surface-3 bg-surface-1 p-4 transition-colors duration-300 hover:border-neutral-1">
              <span class="shrink-0 font-mono text-[14px] text-accent">{f.name}</span>
              <p class="text-[14px] text-neutral-2">{f.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- AI 艺术流水线 -->
      <div class="glass-panel flex flex-col">
        <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.art.label}</p>
        <h3 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">{t.art.heading}</h3>
        <p class="mt-2 text-[14px] leading-relaxed text-neutral-2">
          {t.art.description}
        </p>

        <div class="mt-6 flex flex-wrap gap-2">
          {t.art.styles.map((s) => (
            <span class="rounded-sm border border-surface-3 bg-surface-1 px-3 py-1.5 font-mono text-[14px] text-accent transition-colors duration-300 hover:border-neutral-1">
              {s}
            </span>
          ))}
        </div>
      </div>
    </div>
  </Container>
</Section>
