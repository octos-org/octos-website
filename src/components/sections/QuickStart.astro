---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';
import CodeBlock from 'components/ui/CodeBlock.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    code: string;
  };
}

const { t } = Astro.props;
---

<Section id="quickstart" background="secondary" padY="lg">
  <Container narrow>
    <div class="mb-12 lg:mb-16" data-animate>
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] text-text-bright md:text-[36px] lg:text-[48px]">
        {t.heading}
      </h2>
      <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-neutral-2">
        {t.description}
      </p>
    </div>

    <div data-animate>
      <CodeBlock code={t.code} />
    </div>
  </Container>
</Section>
