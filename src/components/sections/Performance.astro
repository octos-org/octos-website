---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    tableHeaders: { metric: string; octos: string; others: string; note: string };
    benchmarks: { metric: string; octos: string; others: string; note: string }[];
  };
}

const { t } = Astro.props;
---

<Section id="performance" padY="lg">
  <Container>
    <div class="mb-12 lg:mb-16" data-animate>
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
        {t.heading}
      </h2>
      <p class="mt-4 text-[16px] leading-relaxed text-neutral-2">
        {t.description}
      </p>
    </div>

    <div class="overflow-x-auto" data-animate>
      <table class="w-full border-collapse">
        <thead>
          <tr class="border-b border-surface-3">
            <th class="px-4 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-neutral-2">{t.tableHeaders.metric}</th>
            <th class="px-4 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-accent">{t.tableHeaders.octos}</th>
            <th class="px-4 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-accent">{t.tableHeaders.others}</th>
            <th class="hidden px-4 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-highlight md:table-cell">{t.tableHeaders.note}</th>
          </tr>
        </thead>
        <tbody>
          {t.benchmarks.map((row) => (
            <tr class="border-b border-surface-3 transition-colors duration-200 hover:bg-surface-1">
              <td class="px-4 py-3 text-[14px] text-text">{row.metric}</td>
              <td class="px-4 py-3 font-mono text-[14px] text-text-bright">{row.octos}</td>
              <td class="px-4 py-3 font-mono text-[14px] text-accent">{row.others}</td>
              <td class="hidden px-4 py-3 text-[13px] text-highlight md:table-cell">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Container>
</Section>
