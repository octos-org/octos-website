---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';
import LogoGrid from './LogoGrid.astro';
import channels from 'data/channels.json';
---

<Section id="channels" background="secondary" padY="lg">
  <Container>
    <div class="mb-12 lg:mb-16" data-animate>
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">Gateway</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] text-text-bright md:text-[36px] lg:text-[48px]">
        14 messaging channels
      </h2>
      <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-neutral-2">
        Connect your agents to Telegram, Discord, Slack, WhatsApp, and more.
        Every channel supports session control, multi-turn conversations, and file sharing.
      </p>
    </div>

    <div data-animate>
      <LogoGrid items={channels} columns={7} />
    </div>
  </Container>
</Section>
