---
import SvgSection from 'components/ui/SvgSection.astro';

const rows = [
  { dim: 'Language', octos: 'Rust', langchain: 'Python', openclaw: 'TypeScript' },
  { dim: 'Binary / Install', octos: '31MB static', langchain: 'pip + deps', openclaw: '200MB+ node_modules' },
  { dim: 'Startup', octos: '<100ms', langchain: '1-3s', openclaw: '500ms-2s' },
  { dim: 'Memory / gateway', octos: '20MB', langchain: '200MB+', openclaw: '200-300MB' },
  { dim: 'Parallelism', octos: 'True (tokio)', langchain: 'GIL-limited', openclaw: 'V8 event loop' },
  { dim: 'GC pauses', octos: 'None', langchain: 'Python GC', openclaw: 'V8 GC' },
  { dim: 'Tenant density', octos: '200+ profiles', langchain: '~10', openclaw: '~20' },
  { dim: 'LLM providers', octos: '14 built-in', langchain: '50+ (plugins)', openclaw: '10+' },
  { dim: 'LLM orchestration', octos: 'DOT pipelines', langchain: 'Chain/Agent', openclaw: 'Single model' },
  { dim: 'Failover', octos: '3-layer adaptive', langchain: 'Manual', openclaw: 'Basic retry' },
  { dim: 'Channels', octos: '14', langchain: '0', openclaw: '22+' },
  { dim: 'Tool loading', octos: 'Deferred LRU', langchain: 'All upfront', openclaw: 'All upfront' },
  { dim: 'Queue modes', octos: '5', langchain: '1', openclaw: '1' },
  { dim: 'Native docs', octos: 'PPTX/DOCX/XLSX', langchain: 'None', openclaw: 'None' },
  { dim: 'Voice', octos: 'Planned', langchain: 'None', openclaw: 'Wake word + TTS' },
  { dim: 'Native apps', octos: 'REST API', langchain: 'None', openclaw: 'macOS/iOS/Android' },
  { dim: 'Memory system', octos: '3-layer hybrid', langchain: 'Vector only', openclaw: 'SQLite + vector' },
  { dim: 'Security', octos: 'deny(unsafe_code)', langchain: 'Python sandbox', openclaw: 'Docker sandbox' },
];
---

<SvgSection id="comparison" bgSrc="/images/bg-coral-panel.png">
  <div class="glass-panel mb-8">
    <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">Comparison</p>
    <h2 class="mt-3 text-[28px] tracking-[-0.03em] md:text-[36px] lg:text-[48px]">
      Different animals, different oceans
    </h2>
    <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-neutral-2">
      Octos is an operating system, not a framework. It's not competing with chatbot
      libraries — it's the infrastructure they run on.
    </p>
  </div>

  <div class="glass-panel overflow-x-auto">
    <table class="w-full border-collapse text-[13px]">
      <thead>
        <tr class="border-b border-white/10">
          <th class="px-3 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-neutral-1">Dimension</th>
          <th class="px-3 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-accent">Octos</th>
          <th class="px-3 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-neutral-2">LangChain</th>
          <th class="px-3 py-3 text-left font-mono text-[11px] uppercase tracking-[0.08em] text-neutral-2">OpenClaw</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b border-white/5 transition-colors duration-200 hover:bg-white/5">
            <td class="px-3 py-2.5 font-mono text-[12px] text-neutral-2">{row.dim}</td>
            <td class="px-3 py-2.5 text-text-bright">{row.octos}</td>
            <td class="px-3 py-2.5 text-neutral-2">{row.langchain}</td>
            <td class="px-3 py-2.5 text-neutral-2">{row.openclaw}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</SvgSection>
