---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';
import LogoGrid from './LogoGrid.astro';
import channels from 'data/channels.json';

interface Props {
  t: {
    label: string;
    heading: string;
    description: string;
    clients: { name: string; description: string; href: string; linkLabel: string }[];
    channelsLabel: string;
    channelsNote: string;
  };
}

const { t } = Astro.props;
---

<Section id="surfaces" padY="lg">
  <Container>
    <div class="mb-12 lg:mb-16" data-animate>
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.label}</p>
      <h2 class="mt-3 text-[28px] tracking-[-0.03em] text-text-bright md:text-[36px] lg:text-[48px]" set:html={t.heading} />
      <p class="mt-4 max-w-2xl text-[16px] leading-relaxed text-neutral-2">{t.description}</p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden border border-surface-3 md:grid-cols-2 lg:grid-cols-4" data-animate-stagger>
      {t.clients.map((client) => (
        <a
          class="flex flex-col bg-surface-1 p-5 outline outline-1 outline-surface-3 transition-colors duration-200 hover:bg-surface-2"
          href={client.href}
          target="_blank"
          rel="noopener noreferrer"
        >
          <p class="text-[16px] text-text-bright">{client.name}</p>
          <p class="mt-3 flex-1 text-[14px] leading-relaxed text-neutral-2">{client.description}</p>
          <p class="mt-4 font-mono text-[12px] uppercase tracking-[0.06em] text-accent">{client.linkLabel} →</p>
        </a>
      ))}
    </div>

    <div class="mt-12" data-animate>
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{t.channelsLabel}</p>
      <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-neutral-2">{t.channelsNote}</p>
      <div class="mt-6">
        <LogoGrid items={channels} columns={7} />
      </div>
    </div>
  </Container>
</Section>
