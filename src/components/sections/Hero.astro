---
import Button from 'components/ui/Button.astro';
import Badge from 'components/ui/Badge.astro';

interface Props {
  t: {
    badge: string;
    heading: string;
    description: string;
    statsBar: string[];
    buttons: { label: string; href: string }[];
  };
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero-scene relative flex min-h-screen items-end overflow-hidden pb-12 pt-20 lg:pb-16">
  <!-- Background illustration -->
  <div class="absolute inset-0 z-0">
    <img
      src={`${base}/images/ocean-hero.png`}
      alt=""
      class="h-full w-full object-cover"
      loading="eager"
    />
    <!-- Gradient overlay for text readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent" />
  </div>

  <!-- Text directly on background -->
  <div class="relative z-10 w-full px-4 lg:px-9">
    <div class="mx-auto max-w-7xl text-center">
      <Badge text={t.badge} variant="accent" />

      <h1 class="mt-4 text-[40px] leading-[1.05] tracking-[-0.04em] text-white md:text-[64px] 2xl:text-[80px]" set:html={t.heading} />

      <p class="mx-auto mt-6 max-w-2xl text-[18px] leading-relaxed text-white/80 md:text-[20px] lg:text-[22px]">
        {t.description}
      </p>

      <!-- Stats bar -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 font-mono text-[11px] uppercase tracking-[0.08em] text-white/50 md:gap-x-4">
        {t.statsBar.map((stat, i) => (
          <>
            {i > 0 && <span class="text-white/20">|</span>}
            <span>{stat}</span>
          </>
        ))}
      </div>

      <!-- CTAs -->
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <Button href={t.buttons[0].href}>{t.buttons[0].label}</Button>
        <Button href={t.buttons[1].href} variant="outline" external>
          {t.buttons[1].label}
        </Button>
      </div>
    </div>
  </div>
</section>
