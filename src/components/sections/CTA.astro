---
import Section from 'components/layout/Section.astro';
import Container from 'components/layout/Container.astro';
import Button from 'components/ui/Button.astro';

interface Props {
  t: {
    heading: string;
    description: string;
    buttons: { label: string; href: string }[];
  };
}

const { t } = Astro.props;
---

<Section background="secondary" padY="lg">
  <Container narrow class="text-center">
    <div data-animate>
      <h2 class="text-[28px] tracking-[-0.03em] text-text-bright md:text-[36px] lg:text-[48px]" set:html={t.heading} />
      <p class="mx-auto mt-4 max-w-md text-[16px] leading-relaxed text-neutral-2">
        {t.description}
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <Button href={t.buttons[0].href} external>
          {t.buttons[0].label}
        </Button>
        <Button href={t.buttons[1].href} variant="outline" external>
          {t.buttons[1].label}
        </Button>
      </div>
    </div>
  </Container>
</Section>
