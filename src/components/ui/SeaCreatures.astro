---
/**
 * Decorative SVG sea creatures (crabs and lobsters) for ocean sections.
 * Position with absolute positioning inside a relative container.
 */
interface Props {
  variant?: 'floor' | 'coral' | 'deep' | 'hero';
}

const { variant = 'floor' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{variant === 'floor' && (
  <div class="absolute inset-0 z-[1] pointer-events-none">
    <!-- Orange crab bottom-left -->
    <svg viewBox="0 0 80 50" class="absolute bottom-[12%] left-[38%] w-16 md:w-20 opacity-90" aria-hidden="true">
      <ellipse cx="40" cy="28" rx="18" ry="12" fill="#E8722A"/>
      <ellipse cx="40" cy="28" rx="14" ry="9" fill="#F48C3C"/>
      <!-- eyes -->
      <circle cx="34" cy="18" r="3.5" fill="#E8722A"/>
      <circle cx="46" cy="18" r="3.5" fill="#E8722A"/>
      <circle cx="34" cy="17" r="2" fill="#fff"/>
      <circle cx="46" cy="17" r="2" fill="#fff"/>
      <circle cx="34.5" cy="17" r="1" fill="#1a1a2e"/>
      <circle cx="46.5" cy="17" r="1" fill="#1a1a2e"/>
      <!-- eye stalks -->
      <line x1="34" y1="22" x2="34" y2="18" stroke="#E8722A" stroke-width="2.5"/>
      <line x1="46" y1="22" x2="46" y2="18" stroke="#E8722A" stroke-width="2.5"/>
      <!-- claws -->
      <ellipse cx="14" cy="26" rx="8" ry="5" fill="#E8722A" transform="rotate(-20 14 26)"/>
      <ellipse cx="66" cy="26" rx="8" ry="5" fill="#E8722A" transform="rotate(20 66 26)"/>
      <ellipse cx="11" cy="24" rx="5" ry="3" fill="#F48C3C" transform="rotate(-30 11 24)"/>
      <ellipse cx="69" cy="24" rx="5" ry="3" fill="#F48C3C" transform="rotate(30 69 24)"/>
      <!-- legs -->
      <line x1="26" y1="34" x2="18" y2="42" stroke="#E8722A" stroke-width="2" stroke-linecap="round"/>
      <line x1="30" y1="36" x2="24" y2="44" stroke="#E8722A" stroke-width="2" stroke-linecap="round"/>
      <line x1="54" y1="34" x2="62" y2="42" stroke="#E8722A" stroke-width="2" stroke-linecap="round"/>
      <line x1="50" y1="36" x2="56" y2="44" stroke="#E8722A" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <!-- Tiny lobster bottom-right -->
    <svg viewBox="0 0 90 40" class="absolute bottom-[10%] right-[15%] w-14 md:w-18 opacity-85" aria-hidden="true">
      <!-- body -->
      <ellipse cx="50" cy="22" rx="16" ry="8" fill="#C0392B"/>
      <ellipse cx="50" cy="22" rx="12" ry="6" fill="#E74C3C"/>
      <!-- tail -->
      <ellipse cx="70" cy="24" rx="8" ry="5" fill="#C0392B"/>
      <path d="M76 20 L84 16 L82 24 Z" fill="#E74C3C"/>
      <path d="M76 28 L84 32 L82 24 Z" fill="#C0392B"/>
      <!-- claws -->
      <ellipse cx="28" cy="16" rx="7" ry="4" fill="#C0392B" transform="rotate(-15 28 16)"/>
      <ellipse cx="22" cy="13" rx="5" ry="3" fill="#E74C3C" transform="rotate(-25 22 13)"/>
      <ellipse cx="28" cy="28" rx="7" ry="4" fill="#C0392B" transform="rotate(15 28 28)"/>
      <ellipse cx="22" cy="31" rx="5" ry="3" fill="#E74C3C" transform="rotate(25 22 31)"/>
      <!-- eyes -->
      <circle cx="38" cy="16" r="2" fill="#fff"/>
      <circle cx="42" cy="16" r="2" fill="#fff"/>
      <circle cx="38.5" cy="15.5" r="1" fill="#1a1a2e"/>
      <circle cx="42.5" cy="15.5" r="1" fill="#1a1a2e"/>
      <!-- antennae -->
      <path d="M36 14 Q30 6 24 4" stroke="#C0392B" stroke-width="1" fill="none"/>
      <path d="M38 14 Q34 8 30 6" stroke="#C0392B" stroke-width="1" fill="none"/>
      <!-- legs -->
      <line x1="42" y1="28" x2="38" y2="36" stroke="#C0392B" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="48" y1="29" x2="46" y2="37" stroke="#C0392B" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="54" y1="29" x2="56" y2="37" stroke="#C0392B" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
  </div>
)}

{variant === 'coral' && (
  <div class="absolute inset-0 z-[1] pointer-events-none">
    <!-- Small crab on right coral -->
    <svg viewBox="0 0 80 50" class="absolute bottom-[8%] right-[8%] w-12 md:w-16 opacity-85" aria-hidden="true">
      <ellipse cx="40" cy="28" rx="15" ry="10" fill="#E8722A"/>
      <ellipse cx="40" cy="28" rx="11" ry="7" fill="#F48C3C"/>
      <circle cx="35" cy="19" r="3" fill="#E8722A"/>
      <circle cx="45" cy="19" r="3" fill="#E8722A"/>
      <circle cx="35" cy="18" r="1.5" fill="#fff"/>
      <circle cx="45" cy="18" r="1.5" fill="#fff"/>
      <circle cx="35.5" cy="18" r="0.8" fill="#1a1a2e"/>
      <circle cx="45.5" cy="18" r="0.8" fill="#1a1a2e"/>
      <line x1="35" y1="22" x2="35" y2="19" stroke="#E8722A" stroke-width="2"/>
      <line x1="45" y1="22" x2="45" y2="19" stroke="#E8722A" stroke-width="2"/>
      <ellipse cx="18" cy="26" rx="7" ry="4" fill="#E8722A" transform="rotate(-20 18 26)"/>
      <ellipse cx="62" cy="26" rx="7" ry="4" fill="#E8722A" transform="rotate(20 62 26)"/>
      <line x1="28" y1="34" x2="22" y2="40" stroke="#E8722A" stroke-width="1.5" stroke-linecap="round"/>
      <line x1="52" y1="34" x2="58" y2="40" stroke="#E8722A" stroke-width="1.5" stroke-linecap="round"/>
    </svg>
    <!-- Tiny lobster on left -->
    <svg viewBox="0 0 70 30" class="absolute bottom-[6%] left-[12%] w-10 md:w-14 opacity-80" aria-hidden="true">
      <ellipse cx="38" cy="16" rx="12" ry="6" fill="#C0392B"/>
      <ellipse cx="38" cy="16" rx="9" ry="4.5" fill="#E74C3C"/>
      <ellipse cx="54" cy="18" rx="6" ry="4" fill="#C0392B"/>
      <path d="M58 15 L64 12 L63 18 Z" fill="#E74C3C"/>
      <ellipse cx="22" cy="12" rx="5" ry="3" fill="#C0392B" transform="rotate(-15 22 12)"/>
      <ellipse cx="18" cy="10" rx="3.5" ry="2" fill="#E74C3C" transform="rotate(-25 18 10)"/>
      <ellipse cx="22" cy="22" rx="5" ry="3" fill="#C0392B" transform="rotate(15 22 22)"/>
      <ellipse cx="18" cy="24" rx="3.5" ry="2" fill="#E74C3C" transform="rotate(25 18 24)"/>
      <circle cx="30" cy="11" r="1.5" fill="#fff"/>
      <circle cx="33" cy="11" r="1.5" fill="#fff"/>
      <circle cx="30.4" cy="10.6" r="0.7" fill="#1a1a2e"/>
      <circle cx="33.4" cy="10.6" r="0.7" fill="#1a1a2e"/>
      <path d="M28 10 Q24 4 20 3" stroke="#C0392B" stroke-width="0.8" fill="none"/>
    </svg>
  </div>
)}

{variant === 'deep' && (
  <div class="absolute inset-0 z-[1] pointer-events-none">
    <!-- Tiny lobster near bottom seaweed -->
    <svg viewBox="0 0 70 30" class="absolute bottom-[5%] right-[20%] w-10 md:w-14 opacity-75" aria-hidden="true">
      <ellipse cx="38" cy="16" rx="12" ry="6" fill="#8B2020"/>
      <ellipse cx="38" cy="16" rx="9" ry="4.5" fill="#A03030"/>
      <ellipse cx="54" cy="18" rx="6" ry="4" fill="#8B2020"/>
      <path d="M58 15 L64 12 L63 18 Z" fill="#A03030"/>
      <ellipse cx="22" cy="12" rx="5" ry="3" fill="#8B2020" transform="rotate(-15 22 12)"/>
      <ellipse cx="18" cy="10" rx="3.5" ry="2" fill="#A03030" transform="rotate(-25 18 10)"/>
      <ellipse cx="22" cy="22" rx="5" ry="3" fill="#8B2020" transform="rotate(15 22 22)"/>
      <ellipse cx="18" cy="24" rx="3.5" ry="2" fill="#A03030" transform="rotate(25 18 24)"/>
      <circle cx="30" cy="11" r="1.5" fill="rgba(255,255,255,0.6)"/>
      <circle cx="33" cy="11" r="1.5" fill="rgba(255,255,255,0.6)"/>
      <circle cx="30.4" cy="10.6" r="0.7" fill="#1a1a2e"/>
      <circle cx="33.4" cy="10.6" r="0.7" fill="#1a1a2e"/>
      <path d="M28 10 Q24 4 20 3" stroke="#8B2020" stroke-width="0.8" fill="none"/>
    </svg>
    <!-- Small crab near left seaweed -->
    <svg viewBox="0 0 80 50" class="absolute bottom-[8%] left-[8%] w-10 md:w-14 opacity-70" aria-hidden="true">
      <ellipse cx="40" cy="28" rx="14" ry="9" fill="#9B3A1A"/>
      <ellipse cx="40" cy="28" rx="10" ry="6.5" fill="#B8502A"/>
      <circle cx="35" cy="20" r="2.5" fill="#9B3A1A"/>
      <circle cx="45" cy="20" r="2.5" fill="#9B3A1A"/>
      <circle cx="35" cy="19.5" r="1.3" fill="rgba(255,255,255,0.6)"/>
      <circle cx="45" cy="19.5" r="1.3" fill="rgba(255,255,255,0.6)"/>
      <line x1="35" y1="23" x2="35" y2="20" stroke="#9B3A1A" stroke-width="2"/>
      <line x1="45" y1="23" x2="45" y2="20" stroke="#9B3A1A" stroke-width="2"/>
      <ellipse cx="20" cy="26" rx="6" ry="3.5" fill="#9B3A1A" transform="rotate(-20 20 26)"/>
      <ellipse cx="60" cy="26" rx="6" ry="3.5" fill="#9B3A1A" transform="rotate(20 60 26)"/>
    </svg>
  </div>
)}

{variant === 'hero' && (
  <div class="absolute inset-0 z-[1] pointer-events-none">
    <!-- Ferris the Rust crab -->
    <img src={`${base}/images/ferris.svg`} alt="" class="absolute bottom-[6%] left-[3%] w-32 md:w-48 opacity-75" aria-hidden="true" />
    <!-- Lobster with huge claws bottom-right -->
    <svg viewBox="0 0 140 60" class="absolute bottom-[5%] right-[5%] w-32 md:w-48 opacity-75" aria-hidden="true">
      <!-- body segments -->
      <ellipse cx="75" cy="32" rx="20" ry="10" fill="#9B3020"/>
      <ellipse cx="75" cy="32" rx="16" ry="8" fill="#C0392B"/>
      <ellipse cx="82" cy="32" rx="12" ry="7" fill="#9B3020" opacity="0.6"/>
      <!-- tail -->
      <ellipse cx="98" cy="33" rx="8" ry="5" fill="#9B3020"/>
      <ellipse cx="106" cy="34" rx="6" ry="4" fill="#8B2515"/>
      <!-- tail fan -->
      <path d="M110 30 Q118 26 120 30 Q118 34 110 34 Z" fill="#C0392B"/>
      <path d="M110 34 Q118 34 120 38 Q116 40 110 37 Z" fill="#9B3020"/>
      <path d="M110 30 Q116 24 118 28 Q116 30 110 31 Z" fill="#9B3020"/>
      <!-- left arm -->
      <path d="M58 26 Q48 20 38 16" stroke="#9B3020" stroke-width="5" fill="none" stroke-linecap="round"/>
      <!-- left claw - upper pincer -->
      <path d="M38 16 Q30 10 20 6 Q14 4 10 8 Q14 12 22 14 Q28 15 34 16" fill="#C0392B"/>
      <path d="M20 6 Q14 2 8 4 Q6 6 10 8" fill="#9B3020"/>
      <!-- left claw - lower pincer -->
      <path d="M38 16 Q32 18 24 18 Q18 18 14 14 Q18 12 22 14" fill="#B83825"/>
      <!-- right arm -->
      <path d="M58 38 Q48 42 38 46" stroke="#9B3020" stroke-width="5" fill="none" stroke-linecap="round"/>
      <!-- right claw - lower pincer -->
      <path d="M38 46 Q30 52 20 56 Q14 58 10 54 Q14 50 22 48 Q28 47 34 46" fill="#C0392B"/>
      <path d="M20 56 Q14 60 8 58 Q6 56 10 54" fill="#9B3020"/>
      <!-- right claw - upper pincer -->
      <path d="M38 46 Q32 44 24 44 Q18 44 14 48 Q18 50 22 48" fill="#B83825"/>
      <!-- eyes on stalks -->
      <path d="M62 28 Q60 22 58 18" stroke="#9B3020" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <path d="M68 28 Q68 22 70 18" stroke="#9B3020" stroke-width="2.5" fill="none" stroke-linecap="round"/>
      <circle cx="58" cy="17" r="3.5" fill="#1a1a2e"/>
      <circle cx="70" cy="17" r="3.5" fill="#1a1a2e"/>
      <circle cx="57" cy="16" r="2" fill="#fff"/>
      <circle cx="69" cy="16" r="2" fill="#fff"/>
      <circle cx="57.5" cy="15.5" r="1" fill="#1a1a2e"/>
      <circle cx="69.5" cy="15.5" r="1" fill="#1a1a2e"/>
      <!-- antennae -->
      <path d="M60 18 Q50 6 40 2" stroke="#9B3020" stroke-width="1" fill="none"/>
      <path d="M58 19 Q52 10 46 6" stroke="#9B3020" stroke-width="1" fill="none"/>
      <path d="M70 18 Q76 8 82 4" stroke="#9B3020" stroke-width="1" fill="none"/>
      <path d="M72 19 Q76 12 80 8" stroke="#9B3020" stroke-width="1" fill="none"/>
      <!-- walking legs -->
      <line x1="68" y1="40" x2="64" y2="50" stroke="#9B3020" stroke-width="2" stroke-linecap="round"/>
      <line x1="74" y1="40" x2="73" y2="51" stroke="#9B3020" stroke-width="2" stroke-linecap="round"/>
      <line x1="80" y1="40" x2="82" y2="50" stroke="#9B3020" stroke-width="2" stroke-linecap="round"/>
      <line x1="86" y1="39" x2="90" y2="49" stroke="#9B3020" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </div>
)}
