---
/**
 * Section with a decorative SVG background image and frosted glass content.
 * SVG stays fixed while content scrolls over it.
 */
import SeaCreatures from './SeaCreatures.astro';

interface Props {
  id?: string;
  bgSrc: string;
  creatures?: 'floor' | 'coral' | 'deep';
  class?: string;
}

const { id, bgSrc, creatures, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id={id} class:list={['relative overflow-hidden', className]}>
  <!-- Fixed SVG background image -->
  <div class="absolute inset-0 z-0">
    <img src={`${base}${bgSrc}`} alt="" class="h-full w-full object-cover" loading="lazy" />
  </div>
  {creatures && <SeaCreatures variant={creatures} />}

  <!-- Content -->
  <div class="relative z-10 px-4 py-20 lg:px-9 lg:py-32">
    <div class="mx-auto max-w-7xl">
      <slot />
    </div>
  </div>
</section>
