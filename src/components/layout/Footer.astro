---
interface Props {
  links?: { text: string; href: string }[];
  external?: { text: string; href: string }[];
  brand?: string;
  ownership?: string;
  langAlt?: { text: string; href: string };
  navHeading?: string;
  resourcesHeading?: string;
  license?: string;
  langHrefEn?: string;
  langHrefZh?: string;
}

const {
  links = [
    { text: 'Features', href: '#features' },
    { text: 'Architecture', href: '#architecture' },
    { text: 'Performance', href: '#performance' },
    { text: 'Comparison', href: '#comparison' },
    { text: 'Use Cases', href: '#usecases' },
    { text: 'Quick Start', href: '#quickstart' },
    { text: 'FAQ', href: '#faq' },
  ],
  external = [
    { text: 'Documentation', href: 'https://octos-org.github.io/octos/' },
    { text: 'GitHub', href: 'https://github.com/octos-org/octos' },
  ],
  brand = 'Open Cognitive Tasks Orchestration System — a Rust-native, API-first Agentic OS for AI agents.',
  ownership = 'Official deployments: www.octosai.org and learn.pitun.cc — operated by the octos-org maintainers.',
  langAlt = { text: '中文', href: '/zh/' },
  navHeading = 'Navigation',
  resourcesHeading = 'Resources',
  license = 'Open source under the Apache License 2.0.',
  langHrefEn = '/',
  langHrefZh = '/zh/',
} = Astro.props;
---

<footer class="border-t border-surface-3 px-4 py-12 lg:px-9 lg:py-16">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-6">
    <!-- Brand -->
    <div class="lg:col-span-5">
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-text-bright">Octos</p>
      <p class="mt-3 max-w-sm text-[14px] leading-relaxed text-neutral-2">
        {brand}
      </p>
    </div>

    <!-- Nav -->
    <div class="lg:col-span-3">
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{navHeading}</p>
      <nav class="mt-4 flex flex-col gap-3">
        {links.map((link) => (
          <a
            href={link.href}
            class="link-animated w-fit font-mono text-[12px] uppercase tracking-[0.08em] text-text"
          >
            {link.text}
          </a>
        ))}
      </nav>
    </div>

    <!-- External -->
    <div class="lg:col-span-4">
      <p class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2">{resourcesHeading}</p>
      <nav class="mt-4 flex flex-col gap-3">
        {external.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="link-animated w-fit font-mono text-[12px] uppercase tracking-[0.08em] text-text"
          >
            {link.text}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Bottom -->
  <div class="mt-12 border-t border-surface-3 pt-8 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="font-mono text-[12px] tracking-[0.08em] text-neutral-1">
        {license}
      </p>
      <p class="mt-2 font-mono text-[12px] tracking-[0.08em] text-neutral-1">
        {ownership}
      </p>
    </div>
    <div class="flex shrink-0 gap-4">
      <a href={langHrefEn} class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2 hover:text-accent transition-colors duration-200">EN</a>
      <a href={langHrefZh} class="font-mono text-[12px] uppercase tracking-[0.08em] text-neutral-2 hover:text-accent transition-colors duration-200">中文</a>
    </div>
  </div>
</footer>
