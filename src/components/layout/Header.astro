---
import ThemeToggle from 'components/ui/ThemeToggle.astro';

interface Props {
  navLinks?: { text: string; href: string }[];
  externalLinks?: { text: string; href: string }[];
  langAlt?: { text: string; href: string };
}

const {
  navLinks = [
    { text: 'Features', href: '#features' },
    { text: 'Architecture', href: '#architecture' },
    { text: 'Performance', href: '#performance' },
    { text: 'Comparison', href: '#comparison' },
    { text: 'Quick Start', href: '#quickstart' },
  ],
  externalLinks = [
    { text: 'Docs', href: 'https://octos-org.github.io/octos/' },
    { text: 'GitHub', href: 'https://github.com/nicholasgasior/octos' },
  ],
  langAlt = { text: '中文', href: '/zh-cn/' },
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="fixed top-0 z-50 w-full max-w-[1920px] border-b border-surface-3 bg-bg/90 backdrop-blur-sm">
  <div class="flex items-center justify-between px-4 py-4 lg:px-9">
    <!-- Logo -->
    <a href={`${base}/`} class="flex items-center gap-2 font-mono text-[12px] uppercase tracking-[0.08em] text-text-bright">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" class="size-6">
        <circle cx="16" cy="16" r="14" fill="none" stroke="currentColor" stroke-width="1.5"/>
        <text x="16" y="21" text-anchor="middle" font-family="monospace" font-size="14" font-weight="400" fill="currentColor">O</text>
      </svg>
      Octos
    </a>
    <a href={langAlt.href} class="font-mono text-[11px] uppercase tracking-[0.08em] text-neutral-2 hover:text-accent transition-colors duration-200">{langAlt.text}</a>

    <!-- Desktop Nav -->
    <nav class="nav-group hidden items-center gap-8 lg:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="link-animated font-mono text-[12px] uppercase leading-none tracking-[0.08em] text-text"
        >
          {link.text}
        </a>
      ))}
      <span class="h-3 w-px bg-surface-3" />
      {externalLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="link-animated font-mono text-[12px] uppercase leading-none tracking-[0.08em] text-text"
        >
          {link.text}
        </a>
      ))}
      <span class="h-3 w-px bg-surface-3" />
      <ThemeToggle />
    </nav>

    <!-- Mobile: Theme Toggle + Menu Button -->
    <div class="flex items-center gap-3 lg:hidden">
      <ThemeToggle />
    <!-- Mobile Menu Button -->
    <button
      id="menu-toggle"
      class="flex size-8 items-center justify-center lg:hidden"
      aria-label="Toggle menu"
    >
      <span class="menu-icon flex flex-col gap-1.5">
        <span class="block h-px w-5 bg-text transition-all duration-300" />
        <span class="block h-px w-5 bg-text transition-all duration-300" />
      </span>
    </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden border-t border-surface-3 bg-bg px-4 py-8 lg:hidden">
    <nav class="flex flex-col gap-6">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="link-animated font-mono text-[14px] uppercase tracking-[0.08em] text-text"
        >
          {link.text}
        </a>
      ))}
      <span class="h-px w-full bg-surface-3" />
      {externalLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="link-animated font-mono text-[14px] uppercase tracking-[0.08em] text-text"
        >
          {link.text}
        </a>
      ))}
      <span class="h-px w-full bg-surface-3" />
      <a href={langAlt.href} class="link-animated font-mono text-[14px] uppercase tracking-[0.08em] text-text">{langAlt.text}</a>
    </nav>
  </div>
</header>

<style>
  /* Factory.ai sibling dimming */
  .nav-group:hover a {
    opacity: 0.6;
    transition: opacity 0.25s ease;
  }
  .nav-group:hover a:hover {
    opacity: 1;
  }

  /* Mobile menu open state */
  .menu-open .menu-icon span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .menu-open .menu-icon span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    toggle.classList.toggle('menu-open');
  });

  // Close mobile menu on nav link click
  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.classList.remove('menu-open');
    });
  });
</script>
